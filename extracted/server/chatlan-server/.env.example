# Copia este archivo a .env y rellénalo.
# Genera claves con:  openssl rand -hex 32
API_KEY=
# --- Opcional: TURN (coturn) para llamadas entre redes distintas ---
# TURN_SECRET debe ser un secreto distinto de la API key.
TURN_SECRET=
# Ejemplo: turn:TU_IP_O_DOMINIO:3478,turn:TU_IP_O_DOMINIO:3478?transport=tcp
TURN_URLS=
# STUN opcional (necesita internet), p. ej. stun:stun.l.google.com:19302
STUN_URLS=
MAX_ROOM=6
# 1 si hay nginx/Caddy delante (para ver la IP real del cliente)
TRUST_PROXY=1
